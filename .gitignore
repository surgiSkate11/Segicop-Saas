
# Ignoramos archivos de migración de Django:
*.pyc
*.pyo
# Ignoramos archivos de base de datos SQLite:
*.sqlite3
# Ignoramos archivos de medios:
media/
# Archivos privados (certificados de antecedentes):
privado/
staticfiles/
# Ignoramos archivos de configuración de entorno virtual:
env/
venv/
/.venv/
.env
.env.*
!.env.example

# Cachés y artefactos de pruebas:
__pycache__/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
# Ignoramos archivos de configuración de PyCharm:
.idea/
# Configuración local del revisor Gentleman Guardian Angel:
.gga
# Ignoramos archivos del proyecto (requerimientos, certificados de ejemplo, cronogramas),
# salvo la constitución y la guía de prueba manual, que se versionan con el código.
doc/*
!doc/constitution.md
!doc/guia-prueba-manual.md
# Ignoramos los roles iniciales 
apps/identidad/fixtures/roles_iniciales.json
# Node / Tailwind
node_modules/
static/css/tailwind.css
celerybeat-schedule*



